{
  "project_name": "Vietnamese Social Media Toxic Language Detection (DS108)",
  "dataset": {
    "source_file": "data/gold_standard_final_48670.csv",
    "total_rows": 48670,
    "unique_row_ids": 48670,
    "schema": [
      "row_id",
      "comment",
      "toxicity",
      "expression_type",
      "evidence"
    ],
    "taxonomy": {
      "task1": {
        "name": "Toxicity Classification",
        "classes": ["NON-TOXIC", "TOXIC"],
        "counts": {
          "NON-TOXIC": 42810,
          "TOXIC": 5860
        },
        "imbalance_ratio": 7.3055
      },
      "task2": {
        "name": "Expression Type Classification (Toxic subset only)",
        "classes": ["EXPLICIT", "IMPLICIT"],
        "counts": {
          "EXPLICIT": 4999,
          "IMPLICIT": 861
        },
        "imbalance_ratio": 5.8060
      }
    }
  },
  "split_configuration": {
    "strategy": "StratifiedShuffleSplit (80/10/10)",
    "stratify_variable": "_stratum (NON_TOXIC, TOXIC_EXPLICIT, TOXIC_IMPLICIT)",
    "random_state": 42,
    "sizes": {
      "train": 38936,
      "dev": 4867,
      "test": 4867
    }
  },
  "train_class_weights": {
    "task1": {
      "NON-TOXIC": 0.568442,
      "TOXIC": 4.15273
    },
    "task2": {
      "EXPLICIT": 0.586147,
      "IMPLICIT": 3.402032
    }
  },
  "hyperparameters": {
    "optimizer": "AdamW",
    "learning_rate": 0.00002,
    "weight_decay": 0.01,
    "warmup_ratio": 0.1,
    "max_epochs": 5,
    "early_stopping_patience": 2,
    "max_length": 128,
    "physical_batch_size": 16,
    "gradient_accumulation_steps": 2,
    "effective_batch_size": 32,
    "gradient_clipping": 1.0,
    "seed": 42
  },
  "model_architectures": {
    "textcnn": {
      "type": "1D-CNN Baseline",
      "vocab_source": "Train Set only (min_freq=2)",
      "embedding_dim": 200,
      "filter_sizes": [2, 3, 4, 5],
      "num_filters": 100,
      "dropout": 0.5
    },
    "phobert": {
      "type": "Pretrained RoBERTa (Monolingual)",
      "checkpoint": "vinai/phobert-base-v2",
      "segmenter": "pyvi==0.1.1 (ViTokenizer)"
    },
    "videberta": {
      "type": "Pretrained DeBERTa (Disentangled Attention)",
      "checkpoint": "Fsoft-AIC/videberta-base",
      "segmenter": "BPE (Subword)"
    },
    "xlmr": {
      "type": "Pretrained RoBERTa (Multilingual)",
      "checkpoint": "FacebookAI/xlm-roberta-base",
      "segmenter": "SentencePiece (250K subwords)"
    }
  }
}
