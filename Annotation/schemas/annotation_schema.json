{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/ds108/annotation-schema-v2.json",
  "title": "DS108 Vietnamese Comment Annotation Schema",
  "type": "object",
  "required": ["toxicity", "expression_type", "evidence", "needs_review", "review_reason"],
  "properties": {
    "toxicity": {
      "type": ["string", "null"],
      "enum": ["TOXIC", "NON-TOXIC", null]
    },
    "expression_type": {
      "type": ["string", "null"],
      "enum": ["EXPLICIT", "IMPLICIT", null]
    },
    "evidence": {"type": "string"},
    "needs_review": {"type": "boolean"},
    "review_reason": {"type": ["string", "null"]}
  },
  "allOf": [
    {
      "if": {"properties": {"toxicity": {"const": "NON-TOXIC"}}},
      "then": {"properties": {"expression_type": {"const": null}}}
    },
    {
      "if": {"properties": {"toxicity": {"const": "TOXIC"}}},
      "then": {
        "properties": {"expression_type": {"enum": ["EXPLICIT", "IMPLICIT"]}},
        "required": ["expression_type"]
      }
    },
    {
      "if": {"properties": {"toxicity": {"const": null}}},
      "then": {
        "properties": {
          "expression_type": {"const": null},
          "needs_review": {"const": true}
        }
      }
    }
  ]
}
